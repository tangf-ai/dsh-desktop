{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop preview for DeepSeek Harness, supervising the existing loopback Web profile",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/types/main.js",
  "bin": {
    "dsh-desktop": "lib/types/launcher.js"
  },
  "files": [
    "lib/types/**/*.js",
    "assets"
  ],
  "scripts": {
    "build": "tsc -b",
    "dist:mac": "node scripts/build-dmg.mjs",
    "dist:win": "node scripts/build-windows.mjs",
    "start": "node lib/types/launcher.js",
    "test": "vitest run --root ../.. apps/desktop/tests/harness-process.spec.ts apps/desktop/tests/launcher-process.spec.ts",
    "test:dmg": "node tests/dmg-smoke.mjs",
    "test:e2e": "node tests/desktop-smoke.mjs",
    "test:win": "node tests/windows-package-smoke.mjs"
  },
